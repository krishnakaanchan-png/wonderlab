# Local development: copy to .dev.vars and set your Meta key.
MODEL_API_KEY=your-meta-model-api-key

# Optional standalone MCP HTTP mode. Supply a separate long random token.
# WONDERLAB_MCP_TOKEN=
# WONDERLAB_MCP_PORT=4318
# WONDERLAB_INPUT_ROOT=/absolute/path/to/allowed/images
# WONDERLAB_OUTPUT_DIR=/absolute/path/to/generated/projects
# WONDERLAB_PUBLIC_URL=https://your-mcp-host.example

# Set true before making a hosted preview public to disable paid API actions.
# PUBLIC_DEMO_MODE=true
